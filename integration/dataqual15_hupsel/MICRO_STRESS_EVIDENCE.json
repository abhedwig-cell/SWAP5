      "         M_table(start,lay) = 0.0d0",
      "         K_table(start,lay)=conduc1\n         wcontent=watcon(i,wiltpoint)\n         conduc2=hconduc(i,wiltpoint,wcontent,10d0)\n         K_table(start+1,lay)=conduc2\n         M_table(start,lay)=0.5d0*(conduc1+conduc2)*(phead1-wiltpoint)"
    ],
