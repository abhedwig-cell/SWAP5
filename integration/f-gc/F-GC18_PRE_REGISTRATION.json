  "objective": "Define a model-agnostic transactional groundwater-side exchange service seam that can checkpoint, run a trial over a generic coupling window, commit one accepted candidate, or discard a rejected candidate without embedding predictor-corrector orchestration or a MODFLOW API.",
  "production_allowlist": [
    "src/runtime/mod_groundwater_exchange_service_contract.f90"
  ],
  "must_reuse_without_modification": [
    "src/runtime/mod_groundwater_coupling_contract.f90",
    "src/runtime/mod_fmr_checkpoint_orchestrator.f90",
    "src/runtime/mod_fmr_accepted_commit_receipt.f90",
    "src/kernel/mod_kernel_transactions.f90"
  ],
  "required_semantics": [
    "generic finite increasing [t0,t1] window",
    "explicit lineage and origin revision",
    "checkpoint before trial",
    "trial cannot mutate committed state through the contract",
    "commit only a candidate derived from the matching checkpoint and window",
    "rollback/discard leaves committed state unchanged",
    "service implementation remains external-model agnostic",
    "no files, paths, parsing, MODFLOW types or calendar assumptions"
  ],
  "hard_nonclaims": [
    "no predictor-corrector sequencing",
    "no groundwater physics",
    "no MODFLOW adapter",
    "no mass-ledger ownership",
    "no tile/cell aggregation",
    "no application-accuracy binding",
    "no production coupled execution admission"
  ],
  "parallel_ownership_exclusions": {
    "F_GC19": "interface mass ledger and diagnostics",
    "F_GC20": "tile/cell mapping and aggregation",
    "F_GC22": "application/temporal accuracy binding",
    "F_GC21": "predictor-corrector coupling-window orchestration"
  },
  "qualification": [
    "compile at O0 and O2 with runtime checks",
    "fake groundwater service checkpoint-trial-discard-commit lifecycle",
    "same-origin and same-window enforcement",
    "stale candidate rejection",
    "non-midnight/non-day window",
    "exact-head workflow",
    "all 30 architecture invariants"
  ]
}
