      "fixed_resistance": "horizontal_resistance+radial_resistance+entry_resistance"
    },
    "dynamic_vertical_resistance": "(gwl-drain_bottom_level)/Kv_top",
    "resistance_derivative": "1/Kv_top",
    "total_resistance_rule": "must be finite and >0 at evaluation; radial resistance is not separately required to be positive"
