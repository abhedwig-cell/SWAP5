    "geometry_domain": ["drain_spacing>0", "shape_factor>0", "impermeable_base_level<drain_bottom_level", "drain_bottom_level<=interface_level", "Kh_bottom>0", "Kv_top>0", "Kv_bottom>0", "wetted_perimeter>0", "entry_resistance>=0"],
    "prepared_terms": {
