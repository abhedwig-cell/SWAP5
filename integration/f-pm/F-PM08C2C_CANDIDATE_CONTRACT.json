    "dynamic_vertical_resistance": "max(gwl-interface_level,0)/Kv_top + (min(interface_level,gwl)-drain_bottom_level)/Kv_bottom",
    "stable_branch_resistance_derivative": "1/Kv_bottom below interface, 1/Kv_top above interface",
    "interface_derivative": "unavailable exactly at gwl=interface_level when Kv_top!=Kv_bottom; available when both conductivities are identical",
    "total_resistance_rule": "must be finite and >0 at evaluation; radial resistance is not separately required to be positive"
  },
  "IPOS5": {
    "normalized_parameters": ["drain_spacing", "shape_factor", "drain_bottom_level", "impermeable_base_level", "interface_level", "horizontal_conductivity_top", "horizontal_conductivity_bottom", "vertical_conductivity_top", "wetted_perimeter", "geometry_factor", "entry_resistance"],
    "explicitly_omitted_legacy_field": "vertical_conductivity_bottom, because B1.10 IPOS5 never uses kvbot",
