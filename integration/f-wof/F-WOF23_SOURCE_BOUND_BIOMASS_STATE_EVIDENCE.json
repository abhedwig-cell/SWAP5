    "findings": {
      "WRT": "initialized from partitioned TDWI; contributes to maintenance respiration, root death and SWRD=3 root behavior; updated from prior WRT",
      "WST": "initialized from partitioned aboveground biomass; contributes to maintenance respiration and LAI; updated from prior WST",
