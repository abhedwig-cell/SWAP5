  },
  "leaf_cohort_history": {
    "source": "SWAP/wofost.f90:735-761,1769-1884,1892-1943",
    "findings": [
      "Leaf death consumes current cohort biomass and physiological age.",
      "Each update shifts LV, SLA and LVAGE and inserts a new cohort at index 1.",
      "SLA is assigned when a cohort is created and may include actual-crop nutrient effects, so current DVS alone cannot reconstruct historical cohort SLA.",
      "LVAGE controls life-span death and is therefore history, not a diagnostic.",
      "The number of active cohorts controls loop bounds and cohort shifting."
    ],
    "classification": "IRREDUCIBLE_ACTIVE_COHORT_HISTORY",
    "compact_representation": "Store only active equal-length LV/SLA/LVAGE arrays; array length is cohort count."
  },
  "incremental_LAIEXP": {
    "source": "SWAP/wofost.f90:757-761,1057-1074,1818-1835,2264-2266",
    "findings": [
      "LAIEXP is initialized from leaf area and subsequently incremented from its prior value.",
      "LAIEXP is consumed by exponential leaf-area growth logic before the next update.",
      "It cannot in general be reconstructed from only current organ biomass and DVS."
    ],
    "classification": "IRREDUCIBLE_PRIMARY_COMMITTED_BIOMASS_STATE"
  },
  "reconstructible_fields": {
    "WLV": {
      "source": "SWAP/wofost.f90:1924-1943",
      "formula": "ordered sum LV(i), i=1..active cohorts",
      "classification": "RECONSTRUCTIBLE_VIEW"
    },
    "LASUM": {
      "source": "SWAP/wofost.f90:1924-1943",
      "formula": "ordered sum LV(i)*SLA(i), i=1..active cohorts",
