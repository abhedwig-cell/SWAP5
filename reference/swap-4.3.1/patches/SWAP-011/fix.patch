+ FUNCTION RIAKDerivativeFromState(hIn, Kliq, Kvap, thetaRaw, kvapT) RESULT(dKdh)
+! Lazy-state analytical derivative. Kliq, Kvap, thetaRaw and the vapor
+! Kelvin temperature are the constitutive state produced by the immediately
+! preceding SingleKcomponents evaluation for the same node/head/temperature.
+! No conductivity or retention function is re-evaluated here.
+ USE DoublePrec
+ USE SmallestValues, ONLY: Kmin
+ USE Numbers, ONLY: zero, one, ten, three, hundred
+ USE SHPvariables, ONLY: iLayer, mu, UHCChj, hdTarget, SWRCpars, UHCCpars, SWRCbeta, SWRChj, SWRCGhae
+ USE KVapor, ONLY: VaporCond, M_H2O, g, R
+ IMPLICIT NONE
+ REAL (KIND = DP), INTENT(IN) :: hIn, Kliq, Kvap, thetaRaw, kvapT
+ REAL (KIND = DP) :: dKdh, h
+ REAL (KIND = DP) :: alpha, npar, gamma, tau, x, Gfac, Bterm
+ REAL (KIND = DP) :: dlnGdh, dBdh, dKliqdh
+ REAL (KIND = DP) :: thetaLocal, dThetaRawdh, airFilled, cRH, dKvapdh
+
+ h = -ABS(hIn)
+ dKliqdh = zero
+ IF (hIn > UHCCpars(iLayer,1)) THEN
+   dKliqdh = zero
+ ELSE IF (h < -ABS(hdTarget(iLayer))) THEN
+   dKliqdh = zero
+ ELSE IF (h >= -ABS(UHCCpars(iLayer,1))) THEN
+   dKliqdh = zero
+ ELSE IF (h < -ABS(UHCChj(iLayer))) THEN
+   IF (Kliq >= Kmin) dKliqdh = mu * Kliq / h
+ ELSE
+   alpha = UHCCpars(iLayer,2)
+   npar  = UHCCpars(iLayer,3)
+   gamma = UHCCpars(iLayer,5)
+   tau   = UHCCpars(iLayer,6)
+   x     = ABS(alpha*h)
+   Gfac  = (one + x**npar)**((one/npar)-one)
+   Bterm = one - x**(npar-one)*Gfac
+   IF (Kliq >= Kmin .AND. Bterm > zero) THEN
+     dlnGdh = alpha*(npar-one)*x**(npar-one)/(one+x**npar)
+     dBdh   = alpha*(npar-one)*x**(npar-2.0_DP)*Gfac/(one+x**npar)
+     dKliqdh = Kliq * (tau*dlnGdh + gamma*dBdh/Bterm)
+   END IF
+ END IF
+
+ dKvapdh = zero
+ IF (VaporCond .AND. h < -ABS(SWRCpars(iLayer,2)) .AND. Kvap >= Kmin) THEN
+   thetaLocal = thetaRaw
+   airFilled = SWRCpars(iLayer,1) - thetaLocal
+   IF (airFilled > zero) THEN
+     IF (h > SWRCpars(iLayer,2)) THEN
+       dThetaRawdh = zero
+     ELSE IF (ABS(h) >= ABS(hdTarget(iLayer))) THEN
+       dThetaRawdh = zero
+     ELSE IF (ABS(h) >= ABS(SWRChj(iLayer))) THEN
+       dThetaRawdh = SWRCbeta(iLayer)*SWRCpars(iLayer,1)/ABS(h)
+     ELSE IF (ABS(h) >= ABS(SWRCpars(iLayer,2))) THEN
+       alpha = SWRCpars(iLayer,4)
+       npar  = SWRCpars(iLayer,5)
+       x     = ABS(alpha*h)
+       Gfac  = (one+x**npar)**((one/npar)-one)
+       thetaLocal = SWRCpars(iLayer,1)*Gfac/SWRCGhae(iLayer)
+       dlnGdh = alpha*(npar-one)*x**(npar-one)/(one+x**npar)
+       dThetaRawdh = thetaLocal*dlnGdh
+     ELSE
+       dThetaRawdh = zero
+     END IF
+     cRH = M_H2O*g/(hundred*R*kvapT)
+     dKvapdh = Kvap * (cRH - (ten/three)*dThetaRawdh/airFilled)
+   END IF
+ END IF
+ dKdh = dKliqdh + dKvapdh
+ END FUNCTION RIAKDerivativeFromState
