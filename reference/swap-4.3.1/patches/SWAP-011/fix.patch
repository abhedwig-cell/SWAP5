+ LOGICAL FUNCTION RIAStencilCrossesBoundary(h, dh)
+! True when the reference central-difference stencil touches or crosses any branch
+! boundary used by either the RIA retention curve or junction conductivity.
+ USE DoublePrec
+ USE SHPvariables, ONLY: iLayer, SWRCpars, UHCCpars, SWRChj, UHCChj, hdTarget
+ IMPLICIT NONE
+ REAL (KIND = DP), INTENT(IN) :: h, dh
+ REAL (KIND = DP) :: hminus, hplus
+ REAL (KIND = DP), DIMENSION(5) :: boundary
+ INTEGER :: j
+
+ hminus = h - dh
+ hplus  = h + dh
+ boundary(1) = UHCCpars(iLayer,1)
+ boundary(2) = -ABS(UHCChj(iLayer))
+ boundary(3) = -ABS(hdTarget(iLayer))
+ boundary(4) = SWRCpars(iLayer,2)
+ boundary(5) = -ABS(SWRChj(iLayer))
+ RIAStencilCrossesBoundary = .FALSE.
+ DO j = 1, SIZE(boundary)
+   IF (hminus <= boundary(j) .AND. hplus >= boundary(j)) THEN
+     RIAStencilCrossesBoundary = .TRUE.
+     RETURN
+   END IF
+ END DO
+ END FUNCTION RIAStencilCrossesBoundary
