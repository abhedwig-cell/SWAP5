+               flnonconv  = .TRUE.
+            end if
+         end if
+      end if
+
+!     in case of macropores
+      if (swmacro == 1 .AND. IcTopMp == 1) then
+         deviat = pond - pondm1 + epd*dt + reva*dt - (nraidt+nird+Melt)*dt - runon*dt + runots - qtop * dt + ArMpSs * (nraidt+nird+Melt)*dt + QMpLatSs
+         if (abs(deviat) > CritDevPondDt) then
+            flnonconv3 = .TRUE.
+            flnonconv  = .TRUE.
+         end if
