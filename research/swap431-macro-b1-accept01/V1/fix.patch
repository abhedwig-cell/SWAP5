+!     B1 EXPERIMENT V1: certify the current coupled operator at provisional convergence.
+      if (swmacro == 1 .AND. .NOT.flnonconv .AND. dabs(sum1) <= CritDevBalTot) then
+         flunsatok(1:3) = .FALSE.
+         call vector_F(1,hgrad)
