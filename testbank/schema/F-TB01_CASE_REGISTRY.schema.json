{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SWAP5 F-TB01 testbank case registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "source_authority", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry_id": {"type": "string", "pattern": "^F-TB01-[A-Z0-9_-]+$"},
    "source_authority": {
      "type": "object",
      "required": ["repository", "ref", "commit", "tree"],
      "additionalProperties": false,
      "properties": {
        "repository": {"const": "abhedwig-cell/SWAP5"},
        "ref": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "version", "title", "layer", "category", "artifact_kind", "primary_path", "authority_ref", "admission_purpose", "maturity", "oracle_class", "profiles", "invariants", "negative_paths", "mass_gate", "current_preservation_eligible", "notes"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^SWAP5-TB-[A-Z0-9_-]+-[0-9]{3,5}$"},
          "version": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "layer": {"enum": ["TB-L0", "TB-L1", "TB-L2", "TB-L3", "TB-L4", "TB-L5", "TB-L6", "TB-L7", "TB-L8", "TB-L9", "TB-L10", "TB-L11", "TB-L12"]},
          "category": {"enum": ["PRIMITIVE", "HYDRAULICS", "PROCESS", "SOLVER", "TRANSACTION", "RESTART", "INTEGRATED", "LEGACY_REFERENCE", "COUPLING", "MULTISWAP", "PERFORMANCE", "ROBUSTNESS", "RELEASE"]},
          "artifact_kind": {"enum": ["SOURCE_TEST", "QUALIFICATION_EVIDENCE", "GOVERNANCE_REPLAY"]},
          "primary_path": {"type": "string", "minLength": 1},
          "authority_ref": {"type": "string", "minLength": 1},
          "admission_purpose": {"enum": ["HISTORICAL_QUALIFICATION", "MOVING_CURRENT_PRESERVATION", "BROAD_RELEASE_REGRESSION", "OWNER_VERIFICATION", "CHARACTERIZATION"]},
          "maturity": {"enum": ["CHARACTERIZATION", "OWNER_TESTED", "INDEPENDENTLY_QUALIFIED", "CANONICAL_PRESERVATION", "RELEASE_MANDATORY"]},
          "oracle_class": {"enum": ["O1_MATHEMATICAL_EXACT", "O2_MANUFACTURED_SOLUTION", "O3_INDEPENDENT_NUMERICAL_REFERENCE", "O4_QUALIFIED_FULL_RICHARDS_REFERENCE", "O5_LEGACY_SWAP431_SOURCE_BOUND", "O6_PROPERTY_INVARIANT", "O7_CROSS_SOLVER_CONSISTENCY"]},
          "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["FAST", "CANONICAL", "RELEASE", "DEEP"]}},
          "invariants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 30}},
          "negative_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "mass_gate": {"enum": ["REQUIRED", "NOT_WATER_BEARING", "INHERITED_EXACT_AUTHORITY"]},
          "current_preservation_eligible": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
