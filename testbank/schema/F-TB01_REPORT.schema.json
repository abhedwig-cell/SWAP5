{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swap5.invalid/testbank/F-TB01_REPORT.schema.json",
  "title": "SWAP5 Testbank Execution Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","source_authority","matrix_authority","profile","environment","cases","summary"],
  "properties": {
    "schema_version": {"const": "swap5.testbank.report.v1.1"},
    "source_authority": {"type":"object","additionalProperties":false,"required":["repo","commit","tree"],"properties":{"repo":{"const":"abhedwig-cell/SWAP5"},"ref":{"type":["string","null"]},"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"tree":{"type":"string","pattern":"^[0-9a-f]{40}$"}}},
    "matrix_authority": {"type":"object","additionalProperties":false,"required":["registry_id","registry_schema_version","manifest_ref"],"properties":{"registry_id":{"type":"string","minLength":1},"registry_schema_version":{"type":"string","minLength":1},"manifest_ref":{"type":"string","minLength":1}}},
    "profile": {"enum":["FAST","CANONICAL","RELEASE","DEEP"]},
    "environment": {"type":"object","required":["os","compiler","build_flags"],"additionalProperties":true,"properties":{"os":{"type":"string"},"compiler":{"type":"string"},"build_flags":{"type":"string"},"workers":{"type":["integer","null"],"minimum":1},"hardware":{"type":["string","null"]},"openmp":{"type":["string","null"]},"warmup_runs":{"type":["integer","null"],"minimum":0},"repeat_runs":{"type":["integer","null"],"minimum":1}}},
    "cases": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["case_id","case_version","status","admission_purpose","oracle_binding","tolerance_binding","mass_gate","diagnostics","evidence"],"properties":{"case_id":{"type":"string","pattern":"^SWAP5-TB-[A-Z0-9_-]+-[0-9]{3,5}-v[1-9][0-9]*$"},"case_version":{"type":"integer","minimum":1},"status":{"enum":["PASS","FAIL","UNSUPPORTED","TIMEOUT","SKIP_NOT_REQUIRED"]},"admission_purpose":{"enum":["HISTORICAL_QUALIFICATION","MOVING_CURRENT_PRESERVATION","BROAD_RELEASE_REGRESSION","OWNER_VERIFICATION","CHARACTERIZATION"]},"oracle_binding":{"type":"object","additionalProperties":false,"required":["class","id","version"],"properties":{"class":{"enum":["O1_MATHEMATICAL_EXACT","O2_MANUFACTURED_SOLUTION","O3_INDEPENDENT_NUMERICAL_REFERENCE","O4_QUALIFIED_FULL_RICHARDS_REFERENCE","O5_LEGACY_SWAP431_SOURCE_BOUND","O6_PROPERTY_INVARIANT","O7_CROSS_SOLVER_CONSISTENCY"]},"id":{"type":"string","minLength":1},"version":{"type":"integer","minimum":1}}},"tolerance_binding":{"type":"object","additionalProperties":false,"required":["mode","ids"],"properties":{"mode":{"enum":["EXACT_OR_HARD_ONLY","INHERITED_PINNED_AUTHORITY","GOVERNED_BINDINGS"]},"ids":{"type":"array","items":{"type":"string"}}}},"mass_gate":{"type":"object","required":["mode","status"],"additionalProperties":true,"properties":{"mode":{"enum":["REQUIRED","NOT_APPLICABLE","INHERITED_EXACT_AUTHORITY"]},"status":{"enum":["PASS","FAIL","NOT_APPLICABLE"]},"residual":{"type":["number","null"]},"unit":{"type":["string","null"]}}},"diagnostics":{"type":"object","additionalProperties":true},"evidence":{"type":"object","additionalProperties":false,"required":["source_authority","matrix_authority","workflow_or_execution_authority","governance_authority"],"properties":{"source_authority":{"type":"string","minLength":1},"matrix_authority":{"type":"string","minLength":1},"workflow_or_execution_authority":{"type":"string","minLength":1},"governance_authority":{"type":"string","minLength":1}}}}}},
    "summary": {"type":"object","additionalProperties":false,"required":["registered","executed","passed","failed","unsupported","timeouts","mandatory_missing","mass_failures"],"properties":{"registered":{"type":"integer","minimum":0},"executed":{"type":"integer","minimum":0},"passed":{"type":"integer","minimum":0},"failed":{"type":"integer","minimum":0},"unsupported":{"type":"integer","minimum":0},"timeouts":{"type":"integer","minimum":0},"mandatory_missing":{"type":"integer","minimum":0},"mass_failures":{"type":"integer","minimum":0}}}
  }
