{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SWAP5 F-TB02 hydraulic constitutive case registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "architecture_authority", "current_canonical_context", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry_id": {"const": "F-TB02-HYDRAULIC_CONSTITUTIVE_FRAGMENT"},
    "architecture_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_unit", "commit", "tree"],
      "properties": {
        "work_unit": {"const": "F-TB01"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "current_canonical_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "commit", "tree", "use"],
      "properties": {
        "ref": {"const": "integration/f-ci-canonical"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "use": {"const": "SOURCE_CONTEXT_ONLY_NOT_AUTOMATIC_PRESERVATION_AUTHORITY"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "version", "title", "layer", "category", "artifact_kind", "physics", "solver", "parameters", "forcing", "initial_state", "interval", "oracle", "tolerance_policy", "provenance", "source_authority", "test_matrix_authority", "evidence_authority", "governance_authority", "admission_purpose", "maturity", "compiler_requirements", "cost_class", "profiles", "requiredness", "invariants", "negative_paths", "mass_gate", "current_preservation_eligible", "lineage", "notes"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^SWAP5-TB-[A-Z0-9_-]+-[0-9]{3,5}-v[1-9][0-9]*$"},
          "version": {"type": "integer", "minimum": 1},
          "layer": {"enum": ["TB-L0", "TB-L1", "TB-L3"]},
          "category": {"enum": ["PRIMITIVE", "HYDRAULICS", "SOLVER"]},
          "admission_purpose": {"enum": ["HISTORICAL_QUALIFICATION", "CHARACTERIZATION"]},
          "maturity": {"enum": ["OWNER_TESTED", "CHARACTERIZATION"]},
          "mass_gate": {"enum": ["NOT_WATER_BEARING", "REQUIRED"]},
          "current_preservation_eligible": {"const": false}
        }
      }
    }
  }
}
